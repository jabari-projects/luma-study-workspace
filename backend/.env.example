# Copy to .env for local development and supply your own values.
# Load explicitly: python -m uvicorn main:app --env-file .env --reload
# Do not commit the populated .env file.
APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Accounts, database access, and token signing
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET_KEY=

# Optional image-to-notes integration
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional audio transcription
DEEPGRAM_API_KEY=

# Optional subscription checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional internal webhooks and transactional email
WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI usage settings
FREE_AI_DAILY_LIMIT=3
AI_RATE_LIMIT_WINDOW_SECONDS=60
