# Copy to .env for local development and supply your own values.
# Load explicitly: python -m uvicorn main:app --env-file .env --reload
# Do not commit the populated .env file.
APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Accounts, database access, and token signing
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET_KEY=

# Optional image-to-notes and text-to-notes integration
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional audio transcription.
# When OPENAI_API_KEY is set, recordings are turned into text with this OpenAI
# speech-to-text model. Deepgram is only used when no OpenAI key is set.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
DEEPGRAM_API_KEY=

# Optional subscription checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional internal webhooks and transactional email
WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI usage settings
FREE_AI_DAILY_LIMIT=3
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Client IP for rate limits. 0 = ignore X-Forwarded-For (local dev, direct).
# Don't guess this value. On Render, Cloudflare sits in front of Render's proxy, so 1 would
# probably pick a Cloudflare address. Check the real X-Forwarded-For layout on staging first.
# Never set higher than the real number of proxies: extra hops let clients spoof.
TRUSTED_PROXY_HOPS=0
